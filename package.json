{
  "name": "quickdrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Encrypted peer-to-peer file & text transfer via unique session codes",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @quickdrop/web dev",
    "dev:signaling": "pnpm --filter @quickdrop/signaling dev",
    "build": "pnpm --filter @quickdrop/protocol build && pnpm -r --filter !@quickdrop/protocol build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "eslint": "^9.7.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
