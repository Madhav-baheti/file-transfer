# QuickDrop Web Environment Variables (Placeholder values)
# Copy this to .env.local if you need custom endpoints for local development.

# Signaling server WebSocket URL
VITE_SIGNALING_URL=ws://localhost:3001

# Comma-separated list of public STUN server URLs only.
# TURN credentials are fetched from the signaling service and must never be added here.
VITE_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
